<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header: Title, Live Offline Status, Refresh button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHENNAI TRANSIT • LIVE"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/widget_live_dot" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0ms OFFLINE"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="🔄"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Line & Route Header -->
    <TextView
        android:id="@+id/widget_route_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Blue Line: Wimco Nagar ↔ Airport"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Next Departure ETA & Platform Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_eta_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next train: Central Metro in 4 min (06:21 AM)"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_concession_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🌸 Vidiyal Payanam"
            android:textColor="#F472B6"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle / Corridor Info & Phase 2 Announcements -->
    <TextView
        android:id="@+id/widget_corridor_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="⚡ Yellow Line Phase 2: Open to Vadapalani (All stops to Porur)"
        android:textColor="#E2E8F0"
        android:textSize="10sp" />

    <!-- Bottom Actions Row: 3 Touchpoints for Fast Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="🚇 Tracker"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_bus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="🚌 MTC Buses"
            android:textColor="#FCA5A5"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_fare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="💳 Fare &amp; Pass"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
